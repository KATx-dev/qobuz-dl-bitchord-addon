# HTTP server
PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=60

# Provider selection. qobuzdl uses the public Qobuz-DL-compatible API routes.
QOBUZ_PROVIDER=qobuzdl
QOBUZ_UPSTREAM_BASE_URL=https://qobuz.vercel.app

# Only for an authorized, documented provider implementation.
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
