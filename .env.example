# HTTP server
PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=60

# Provider selection. The default is intentionally empty because the public
# qobuz.vercel.app site does not publish a documented addon API.
QOBUZ_PROVIDER=stub

# Only for an authorized, documented provider implementation.
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
